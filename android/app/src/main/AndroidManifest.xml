<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- La emulacion de la GPU Xenos va sobre Vulkan 1.1 como minimo. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x401000"
        android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Red del juego en LAN (opciones red_lan / red_dns del motor nativo; ver
         docs/diario/red-y-privilegios.md). Sin INTERNET, Android no deja abrir
         ningun socket; el multicast es para que dos aparatos se encuentren por
         broadcast en la Wi-Fi. Todo esto lo usa solo el juego, y solo si se piden
         esas opciones. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- El servidor de EA en este movil ("anfitrion", ServidorLanService): un
         servicio en primer plano para que siga vivo mientras el juego corre en
         su proceso, y su notificacion (IP y jugadores, boton de parar). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Es un juego: appCategory es lo que leen Android 12+ (modo de juego y
         panel de juegos) y los lanzadores; isGame, el indicador de antes, lo
         siguen mirando los lanzadores de juegos de algunos fabricantes. -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material">

        <!-- Modo de juego de Android 12+: que el sistema no baje la resolucion
             ni limite los fps por su cuenta. La app ya tiene sus ajustes para
             eso (resolucion de render, limite de fps), y encima de ellos solo
             liarian lo que mide y lo que se elige. -->
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <!-- Deja perfilar la app con simpleperf desde adb sin root ni APK de
             depuracion. Sin esto, medir donde se va el tiempo en un movil de
             serie no es posible. No cambia nada para quien solo juega. -->
        <profileable android:shell="true" />

        <!-- La pantalla de inicio va en horizontal como la partida: menu de
             secciones a la izquierda, la elegida a la derecha. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Tema.Inicio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Proceso propio: las librerias nativas no se pueden recargar, asi
             que cada partida (o sonda) empieza en un proceso limpio. Ver
             GameActivity.java. configChanges como en la plantilla de SDL3:
             girar o conectar un mando no debe recrear la actividad. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":juego"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />

        <!-- Editor del mando tactil, desde la pantalla de inicio. Apaisado y a
             pantalla completa como la partida, para que los controles caigan
             en el mismo sitio. -->
        <activity
            android:name=".EditorTactilActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- El servidor de salas de EA de la LAN, cuando este movil es el
             anfitrion. specialUse: ninguno de los otros tipos describe un
             servidor de juego en la red local. -->
        <service
            android:name=".ServidorLanService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Lobby server for local network multiplayer between devices" />
        </service>
    </application>

</manifest>
